# Memory of Records - 환경 변수 설정

# ========================================
# Vite 빌드 설정
# ========================================

# GitHub Pages 배포 시 base 경로 (예: /repository-name/)
# 로컬 개발 시에는 비워두거나 '/' 사용
# VITE_BASE_PATH=/

# ========================================
# Notion API 설정
# ========================================

# Notion API 키 (Integration Token)
# Notion 워크스페이스에서 Integration을 생성하고 받은 토큰을 입력하세요.
# https://www.notion.so/my-integrations
# 주의: 클라이언트에서 직접 사용하지 말고 서버리스 함수를 통해 사용하세요.
# VITE_NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxx

# Notion 데이터베이스 ID (Period별 노트북 DB)
# Notion 데이터베이스 URL에서 확인할 수 있습니다.
# 예: https://notion.so/xxxxxxxxxxxxx?v=yyyyyyyyy
#     -> xxxxxxxxxxxxx 부분이 데이터베이스 ID
# VITE_NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion API 프록시 URL (선택사항)
# 클라이언트에서 직접 Notion API를 호출하지 않고 프록시를 통해 호출할 경우
# 프록시 서버의 URL을 입력하세요.
# VITE_NOTION_PROXY_URL=https://your-proxy-server.com/api/notion

# ========================================
# 배포 환경별 설정 팁
# ========================================

# GitHub Pages:
#   - VITE_BASE_PATH는 자동으로 설정됩니다 (GitHub Actions에서)
#   - Notion API 키는 GitHub Secrets에 저장하세요

# Vercel:
#   - 환경 변수는 Vercel Dashboard에서 설정하세요
#   - Production, Preview, Development 환경별로 다르게 설정 가능

# Netlify:
#   - 환경 변수는 Netlify Dashboard에서 설정하세요
#   - Build environment variables 섹션에 추가
