# Memory of Records - 환경 변수 설정

# ========================================
# Vite 빌드 설정
# ========================================

# GitHub Pages 배포 시 base 경로 (예: /repository-name/)
# 로컬 개발 시에는 비워두거나 '/' 사용
# VITE_BASE_PATH=/

# ========================================
# Notion API 설정 (서버리스 /api/* 전용 — 클라이언트에 VITE_ 노출 금지)
# ========================================

# Notion API 키 (Integration Token)
# https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxx

# Notion 데이터베이스 ID (노트북 DB)
# 예: https://notion.so/xxxxxxxxxxxxx?v=yyyyyyyyy → xxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 삭제된 노트 휴지통 DB (노트북 DB와 동일 속성 + 삭제 일시 Date 권장)
# 추천 Notion DB 이름: trash (값은 URL의 데이터베이스 ID)
# NOTION_TRASH_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_TRASH_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========================================
# Cloudinary (표지 업로드 · 페이지 이미지)
# ========================================

# cloudinary://{api_key}:{api_secret}@{cloud_name}
# CLOUDINARY_URL=cloudinary://xxxx:yyyy@zzzz

# 또는 개별 변수:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# 표지 업로드 루트 폴더 (선택, 기본: Notebooks_v3/Cover)
# Front/Back 하위 폴더에 노트명으로 저장됩니다.
# CLOUDINARY_COVER_FOLDER=Notebooks_v3/Cover

# 본문 페이지 업로드 루트 (선택, 기본: Notebooks_v3/Content)
# 노트별 하위 폴더에 page-000001.jpg 형식으로 저장됩니다.
# 북마크 모아보기도 이 루트만 검색합니다.
# CLOUDINARY_CONTENT_FOLDER=Notebooks_v3/Content

# ========================================
# 관리자 로그인 (/api/auth)
# ========================================

# 공유 관리자 비밀번호 (클라이언트에 노출하지 마세요)
# ADMIN_PASSWORD=change-me

# 로컬 `npm run dev` / `vercel dev` 에서는 테스트용 비밀번호 1114 도 로그인됩니다.
# 프로덕션·프리뷰 빌드에서는 동작하지 않습니다.

# 세션 쿠키 서명용 비밀값 (미설정 시 ADMIN_PASSWORD를 사용 — 운영에서는 별도 권장)
# AUTH_SECRET=long-random-string

# ========================================
# 배포 환경별 설정 팁
# ========================================

# GitHub Pages:
#   - VITE_BASE_PATH는 자동으로 설정됩니다 (GitHub Actions에서)
#   - Notion API 키는 GitHub Secrets에 저장하세요

# Vercel:
#   - 환경 변수는 Vercel Dashboard에서 설정하세요
#   - Production, Preview, Development 환경별로 다르게 설정 가능

# Netlify:
#   - 환경 변수는 Netlify Dashboard에서 설정하세요
#   - Build environment variables 섹션에 추가
